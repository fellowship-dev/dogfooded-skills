{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fellowship.dev/jev-evidence/bundle-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "toolkit_version": {
      "const": "1.0.0"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "scores": {
      "$ref": "#/$defs/scores"
    },
    "choices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/choice"
      }
    }
  },
  "required": [
    "schema_version",
    "toolkit_version",
    "identity",
    "policy",
    "attempts",
    "evidence",
    "scores",
    "choices"
  ],
  "additionalProperties": false,
  "$defs": {
    "weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "pattern": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "wrapper_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_boundary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "state_hash": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "state_builder_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "questions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "criteria": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": "object",
          "properties": {
            "requested": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "resolved": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "requested",
            "resolved"
          ],
          "additionalProperties": false
        },
        "provider": {
          "type": "object",
          "properties": {
            "endpoint": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "route": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "protocol": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "sdk": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "endpoint",
            "route",
            "protocol",
            "sdk"
          ],
          "additionalProperties": false
        },
        "inference_config": {
          "type": "object"
        }
      },
      "required": [
        "pattern",
        "wrapper_revision",
        "source_boundary",
        "source_revision",
        "state_hash",
        "state_builder_revision",
        "adapter_revision",
        "questions",
        "criteria",
        "candidates",
        "model",
        "provider",
        "inference_config"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "weights": {
          "$ref": "#/$defs/weights"
        }
      },
      "required": [
        "revision",
        "weights"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "success",
            "empty",
            "fallback",
            "partial",
            "failed",
            "cache_replayed"
          ]
        },
        "raw_response_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "cost": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "cost"
          ],
          "additionalProperties": false
        },
        "nondeterministic": {
          "type": "boolean"
        }
      },
      "required": [
        "attempt_id",
        "invocation_id",
        "timestamp",
        "status",
        "raw_response_ref",
        "usage",
        "nondeterministic"
      ],
      "additionalProperties": false
    },
    "adjudication": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": [
            "human",
            "outcome"
          ]
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_span": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "independently_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "origin",
        "by",
        "source_ref",
        "source_span",
        "source_revision",
        "independently_verified"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "human",
            "machine",
            "outcome",
            "heuristic",
            "synthetic",
            "disputed",
            "unjudged"
          ]
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_span": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {},
        "adjudication": {
          "anyOf": [
            {
              "$ref": "#/$defs/adjudication"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "eligible_uses": {
          "type": "array",
          "items": {
            "enum": [
              "development",
              "reference"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "origin",
        "source_ref",
        "source_span",
        "source_revision",
        "attribution",
        "observation",
        "adjudication",
        "supersedes",
        "eligible_uses"
      ],
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "probabilities": {
          "$ref": "#/$defs/scores"
        },
        "choice": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "options",
        "probabilities",
        "choice"
      ],
      "additionalProperties": false
    }
  },
  "x-contract": [
    "finite JSON only",
    "unique attempt and evidence IDs",
    "supersedes references earlier evidence; retries immutable",
    "reference requires source provenance and independent human/outcome adjudication; synthetic disputed unjudged excluded",
    "choice probabilities exactly match options; sum within [0.98,1.02]; choice is argmax"
  ]
}
